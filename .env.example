APP_NAME="El Pirry"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=usuarios
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120

# Número de WhatsApp del negocio (formato internacional Colombia, sin
# espacios, guiones ni símbolos; ejemplo de formato: 57XXXXXXXXXX).
# Déjalo vacío hasta tener el número real: sin él, el botón solo muestra un aviso.
WHATSAPP_NUMERO_NEGOCIO=

# ---------------------------------------------------------------
# Gmail API: envío de correos con la cuenta de Google emisora
# (recuperación de contraseña). Los usuarios finales NO inician
# sesión con Google: solo autoriza el sistema como remitente.
# 1. En Google Cloud Console: habilita la Gmail API, crea un
#    "ID de cliente OAuth" tipo "Aplicación de escritorio" y
#    registra la URI de redirección EXACTA: http://127.0.0.1:8765
# 2. Pega aquí el ID de cliente y el secreto del cliente.
# 3. Ejecuta: php artisan gmail:authorize
#    (el refresh token se muestra UNA SOLA VEZ en la terminal)
# 4. GOOGLE_GMAIL_FROM debe ser el correo de la cuenta autorizada.
# NUNCA escribas el Client Secret ni el Refresh Token en el código.
# ---------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_GMAIL_FROM=
