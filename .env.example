APP_NAME="El Pirry"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=usuarios
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120

# Número de WhatsApp del negocio (formato internacional Colombia, sin
# espacios, guiones ni símbolos; ejemplo de formato: 57XXXXXXXXXX).
# Déjalo vacío hasta tener el número real: sin él, el botón solo muestra un aviso.
WHATSAPP_NUMERO_NEGOCIO=

# ---------------------------------------------------------------
# Resend: servicio externo de envío de correos (recuperación de
# contraseña). Coloca TU API Key real en RESEND_API_KEY.
# Consíguela en https://resend.com -> API Keys (formato re_xxxxxxxx).
# NUNCA escribas la API Key directamente en el código.
# Con una cuenta nueva sin dominio verificado, deja RESEND_FROM_EMAIL
# como onboarding@resend.dev (Resend solo permite enviar a tu propio
# correo en ese modo).
# ---------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME="El Pirry"
