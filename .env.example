APP_NAME="El Pirry"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=usuarios
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120

# Número de WhatsApp del negocio (formato internacional Colombia, sin
# espacios, guiones ni símbolos; ejemplo de formato: 57XXXXXXXXXX).
# Déjalo vacío hasta tener el número real: sin él, el botón solo muestra un aviso.
WHATSAPP_NUMERO_NEGOCIO=

# Recuperación de contraseña (RF-017/018): correo enviado a través de una
# API externa de correo transaccional (Resend, Mailgun, Brevo, SendGrid,
# Postmark...) usando su relay SMTP. Ejemplo con Resend:
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.resend.com
#   MAIL_PORT=587
#   MAIL_USERNAME=resend
#   MAIL_PASSWORD=re_xxxxxxxxxxxxxxxxxxxxxxxx   <- API key del proveedor
#   MAIL_ENCRYPTION=tls
# Mientras no se configure, Laravel usa el driver "log": el correo no se
# envía, pero queda escrito en storage/logs/laravel.log (útil en desarrollo).
MAIL_MAILER=log
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-responder@elpirry.com"
MAIL_FROM_NAME="${APP_NAME}"
